<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
    <model name="swimming_pool">
        <static>true</static>
  <link name="pool">
      <visual name="visual">
                <geometry>
                    <mesh>
          <uri>model://swimming_pool/meshes/2mm.dae</uri>
                    </mesh>
                </geometry>
            </visual>
    <collision name="pool_collision">
      <geometry>
        <mesh>
          <uri>model://swimming_pool/meshes/2mm.dae</uri>
          <scale>1 1 1</scale>
        </mesh>
      </geometry>
      <surface>
        <contact>
          <collide_without_contact>false</collide_without_contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </link>
    </model>
</sdf>